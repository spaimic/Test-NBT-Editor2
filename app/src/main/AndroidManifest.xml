<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <queries>
        <package android:name="moe.shizuku.privileged.api" />
        <package android:name="rikka.shizuku" />
    </queries>

    <application
        android:name=".NbtToolApp"
        android:allowBackup="true"
        android:label="NBT Tool"
        android:theme="@style/Theme.AppCompat.Light"
        android:requestLegacyExternalStorage="true">

        <activity
            android:name=".ui.IntroActivity"
            android:exported="false"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />

        <activity
            android:name=".ui.WorldListActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.EditorActivity"
            android:exported="false" />

        <activity
            android:name=".ui.PlayerDbActivity"
            android:exported="false" />

        <activity
            android:name=".ui.DbEntryEditorActivity"
            android:exported="false" />

        <activity
            android:name=".ui.ChunkClipboardActivity"
            android:exported="false" />

        <activity
            android:name=".ui.ChunkBlockEditorActivity"
            android:exported="false" />

        <activity
            android:name=".ui.Chunk3DViewerActivity"
            android:exported="false" />

        <activity
            android:name=".ui.McStructureBrowserActivity"
            android:exported="false" />

        <activity
            android:name=".ui.McStructureAnalyzerActivity"
            android:exported="false" />

        <activity
            android:name=".ui.McStructure3DPreviewActivity"
            android:exported="false" />

        <activity
            android:name=".ui.McStructurePlacementActivity"
            android:exported="false" />

        <activity
            android:name=".ui.ClipboardActivity"
            android:exported="false" />

        <activity
            android:name=".ui.ImportFromMinecraftActivity"
            android:exported="false" />

        <activity
            android:name=".ui.MapViewerActivity"
            android:exported="false" />

        <activity
            android:name=".ui.EntityListActivity"
            android:exported="false" />

        <activity
            android:name=".ui.BlockEntityListActivity"
            android:exported="false" />

        <activity
            android:name=".ui.BlockEntityEditorActivity"
            android:exported="false" />

        <activity
            android:name=".ui.FlatWorldGeneratorActivity"
            android:exported="false" />

        <!-- Required so Shizuku can bind into this app -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- Hands exported .mcworld files to Minecraft (or a chooser) without needing a public path -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
